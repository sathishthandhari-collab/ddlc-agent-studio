# ==============================================================================
# DDLC Agent Studio — Environment Variables Template
# Copy to .env and fill in credentials. Never commit .env to version control.
# ==============================================================================

# Runtime Environment (development | staging | production)
DDLC_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL + pgvector Unified Storage
# Replace user, password, host, port, and database name with your Step 1 values.
# ------------------------------------------------------------------------------
# Runtime role (least-privilege writer; no DROP TABLE or TRUNCATE)
CHECKPOINTER_DB_URI=postgresql://ddlc_app:CHANGE_ME@localhost:5432/ddlc_metadata
METADATA_DB_URI=postgresql://ddlc_app:CHANGE_ME@localhost:5432/ddlc_metadata
RAG_DB_URI=postgresql://ddlc_app:CHANGE_ME@localhost:5432/ddlc_metadata

# Migration / Admin role (used exclusively by DCM / Alembic CLI)
DCM_MIGRATION_DB_URI=postgresql://ddlc_admin:CHANGE_ME@localhost:5432/ddlc_metadata

# ------------------------------------------------------------------------------
# LLM & Embedding Provider Keys (Consumed by LiteLLM)
# Default stack routes open-source LLMs and embeddings through OpenRouter
# (https://openrouter.ai/keys). Set other keys only if you switch providers
# in config/model_tiers.yaml or config/settings.yaml.
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OR_SITE_URL=https://github.com/your-org/ddlc-agent-studio
# OR_APP_NAME=ddlc-agent-studio

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Sandbox & Git Delivery
# ------------------------------------------------------------------------------
DBT_SANDBOX_DIR=./sandbox/dbt_dev
GITHUB_TOKEN=
