        prompt_content = prompt_tmpl.render(
            input=input_data,
            diagnostics=list(self.context.get("diagnostics") or []),
            feedback=[],
            config=prompt_cfg,
        )
{% else %}
        prompt_content = str(input_data)
{% endif %}
        llm_result = self._call_llm(
            model=_resolve_model_for_tier(self.settings, {{ stg.model_tier | tojson }}),
            response_model={{ stg.llm_output_model }},
            system_msg={{ (stg.system_prompt or ("Execute stage: " + stg.stage_name)) | tojson }},
            prompt_content=prompt_content,
            temperature={{ stg.temperature }},
            max_tokens={{ stg.max_tokens }},
