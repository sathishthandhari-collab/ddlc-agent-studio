{% if stg.llm_output_model == "GeneratedFileSet" and stg.output_model and stg.output_contract %}
        sandbox_dir = getattr(getattr(self.settings, "dbt", None), "sandbox_project_dir", "./sandbox/artifacts")
        out_obj = {{ stg.output_model }}.model_validate(_stage_claim_check_bundle(llm_result, sandbox_dir))
        contracts[{{ stg.output_contract | tojson }}] = out_obj.model_dump()
