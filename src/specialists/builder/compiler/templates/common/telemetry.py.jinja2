{{ header }}from __future__ import annotations

import logging
from typing import Any, Optional

logger = logging.getLogger(__name__)


class _NoOpTelemetryCallback:
    """Graceful fallback callback when studio metadata package is unavailable standalone."""

    def __init__(self, **kwargs: Any) -> None:
        self.kwargs = kwargs


def create_telemetry_handler(
    *,
    run_id: str,
    agent_id: str = {{ agent_name | tojson }},
    agent_version: str = {{ agent_version | tojson }},
    db_uri: Optional[str] = None,
) -> Any:
    """Instantiate passive Tier 1 MetadataCallbackHandler if available, else no-op observer."""
    try:
        from src.metadata.callbacks import MetadataCallbackHandler

        return MetadataCallbackHandler(
            run_id=run_id,
            agent_id=agent_id,
            agent_version=agent_version,
            db_uri=db_uri,
        )
    except Exception as exc:
        logger.debug("MetadataCallbackHandler unavailable (%s); using no-op telemetry callback.", exc)
        return _NoOpTelemetryCallback(
            run_id=run_id,
            agent_id=agent_id,
            agent_version=agent_version,
        )
