{{ header }}from __future__ import annotations

from datetime import date, datetime, timezone
from typing import Any, Dict, List, Literal, Optional

from pydantic import BaseModel, Field, field_validator
{% if include_generated_fileset %}

class GeneratedFile(BaseModel):
    """Single synthesized file emitted by an LLM code-generation stage."""

    path: str = Field(..., description="Relative file path within the artifact bundle.")
    content: str = Field(..., description="Complete file source code or configuration text.")


class GeneratedFileSet(BaseModel):
    """Structured LLM output wrapper staged to disk by a deterministic Claim Check node."""

    files: List[GeneratedFile] = Field(
        default_factory=list,
        description="Set of generated files to stage into the sandbox bundle.",
    )
