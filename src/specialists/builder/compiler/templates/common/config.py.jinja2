class AgentSettings(BaseSettings, FrameworkRuntimeSettings):
    """Externalized runtime configuration compiled deterministically from config.yaml."""

    model_config = SettingsConfigDict(
        env_prefix="AGENT_",
        env_nested_delimiter="__",
        env_file=".env",
        extra="ignore",
        populate_by_name=True,
    )

    ENVIRONMENT: str = Field(default="development")
{% for fld in top_fields %}
    {{ fld.attr_name }}: {{ fld.annotation }} = {{ fld.default_expr }}
{% endfor %}
{% for sec in secret_fields %}
    {{ sec.attr_name }}: str = Field(
        default_factory=lambda: os.getenv({{ sec.env_key | tojson }}, ""),
        description={{ sec.description | tojson }},
    )
{% endfor %}


@lru_cache()
def get_settings() -> AgentSettings:
    """Lazy loader for AgentSettings supporting isolated zero-infra unit testing."""
    return AgentSettings()
