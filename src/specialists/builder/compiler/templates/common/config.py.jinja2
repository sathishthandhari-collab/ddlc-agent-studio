from pydantic import BaseModel, ConfigDict, Field
from pydantic_settings import BaseSettings, SettingsConfigDict


class FrameworkRuntimeSettings(BaseModel):
    """Standard framework mixin for runtime state and metadata persistence."""

    CHECKPOINTER_DB_URI: str = Field(
        default_factory=lambda: os.getenv(
            "CHECKPOINTER_DB_URI",
            "postgresql://localhost:5432/agent_checkpoints",
        )
    )
    METADATA_DB_URI: str = Field(
        default_factory=lambda: os.getenv(
            "METADATA_DB_URI",
            "postgresql://localhost:5432/ddlc_metadata",
        )
    )
    RAG_DB_URI: str = Field(
        default_factory=lambda: os.getenv(
            "RAG_DB_URI",
            "postgresql://localhost:5432/ddlc_metadata",
        )
    )
{% for model in nested_models %}

class {{ model.class_name }}(BaseModel):
    model_config = ConfigDict(populate_by_name=True)
